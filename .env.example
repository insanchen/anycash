# Database
# Used when you run the app with `pnpm dev` or `pnpm start`.
# `docker compose` builds its own DATABASE_URL from the POSTGRES_* values below.
DATABASE_URL=postgres://app_user:change-me@localhost:5432/app_db

# Docker Compose
# POSTGRES_PASSWORD, ACCESS_TOKEN_SECRET, REFRESH_TOKEN_SECRET, and ADMIN_PASSWORD
# have no defaults. `docker compose up` stops with an error until you set them.
POSTGRES_DB=anycash
POSTGRES_USER=anycash
POSTGRES_PASSWORD=change-me-database-password
APP_PORT=8802

# Auth secrets
# Generate each one with `openssl rand -hex 32`.
ACCESS_TOKEN_SECRET=change-me-access-token
REFRESH_TOKEN_SECRET=change-me-refresh-token
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Admin account created on first start
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=change-me-admin-password

# Rate limiting
AUTH_RATE_LIMIT_PER_MIN=20
API_RATE_LIMIT_PER_MIN=100
API_BURST_LIMIT=20

# Exchange rate
EXCHANGE_RATE_PROVIDER=manual
EXCHANGE_RATE_API_KEY=

# App
DEFAULT_LANGUAGE=id
NODE_ENV=development
